{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "ProcessManagerSCIMSync",
      "metadata": {
        "description": "Name of the Logic App"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "scimApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "Process Manager SCIM API Bearer Token"
      }
    },
    "roleMappingStorageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name where role-mapping.json and delta token are stored"
      }
    },
    "roleMappingContainerName": {
      "type": "string",
      "defaultValue": "config",
      "metadata": {
        "description": "Container name where role-mapping.json is stored"
      }
    },
    "updateMode": {
      "type": "string",
      "defaultValue": "preserve",
      "allowedValues": [
        "preserve",
        "replace"
      ],
      "metadata": {
        "description": "Role update mode: preserve (add roles) or replace (replace all roles)"
      }
    },
    "mappingMode": {
      "type": "string",
      "defaultValue": "dynamic",
      "allowedValues": [
        "dynamic",
        "mapped"
      ],
      "metadata": {
        "description": "Mapping mode: dynamic (use names as-is) or mapped (use role-mapping.json)"
      }
    },
    "pollingIntervalMinutes": {
      "type": "int",
      "defaultValue": 5,
      "minValue": 1,
      "maxValue": 60,
      "metadata": {
        "description": "How often (in minutes) to poll Microsoft Graph for user changes"
      }
    },
    "filterToExistingRoles": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "If true, user groups/departments are filtered so only those that already exist as roles in Process Manager are synced. Prevents AD groups from creating new roles in PM. Requires processManagerSiteUrl, processManagerUsername, processManagerPassword."
      }
    },
    "processManagerSiteUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Process Manager tenant base URL, e.g. https://demo.promapp.com/{tenantId}. Used to fetch an OAuth token and the roles list. No trailing slash."
      }
    },
    "processManagerUsername": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Process Manager service-account username used for the OAuth password-grant token request."
      }
    },
    "processManagerPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Process Manager service-account password used for the OAuth password-grant token request."
      }
    }
  },
  "variables": {
    "azureblobConnectionName": "[concat('azureblob-', uniqueString(resourceGroup().id))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('azureblobConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Azure Blob Storage Connection",
        "api": {
          "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azureblob')]"
        },
        "parameterValues": {
          "accountName": "[parameters('roleMappingStorageAccountName')]",
          "accessKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('roleMappingStorageAccountName')), '2021-09-01').keys[0].value]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('azureblobConnectionName'))]"
      ],
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "scimApiKey": {
              "defaultValue": "[parameters('scimApiKey')]",
              "type": "SecureString"
            },
            "updateMode": {
              "defaultValue": "[parameters('updateMode')]",
              "type": "String"
            },
            "mappingMode": {
              "defaultValue": "[parameters('mappingMode')]",
              "type": "String"
            },
            "filterToExistingRoles": {
              "defaultValue": "[parameters('filterToExistingRoles')]",
              "type": "Bool"
            },
            "processManagerSiteUrl": {
              "defaultValue": "[parameters('processManagerSiteUrl')]",
              "type": "String"
            },
            "processManagerUsername": {
              "defaultValue": "[parameters('processManagerUsername')]",
              "type": "String"
            },
            "processManagerPassword": {
              "defaultValue": "[parameters('processManagerPassword')]",
              "type": "SecureString"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": "[parameters('pollingIntervalMinutes')]"
              }
            }
          },
          "actions": {
            "Initialize_changed_users": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "changedUsers",
                    "type": "array",
                    "value": []
                  }
                ]
              }
            },
            "Initialize_has_more_pages": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "hasMorePages",
                    "type": "boolean",
                    "value": true
                  }
                ]
              }
            },
            "Initialize_current_url": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "currentUrl",
                    "type": "string",
                    "value": ""
                  }
                ]
              }
            },
            "Initialize_new_delta_link": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "newDeltaLink",
                    "type": "string",
                    "value": ""
                  }
                ]
              }
            },
            "Initialize_valid_roles_lower": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "validRolesLower",
                    "type": "array",
                    "value": []
                  }
                ]
              }
            },
            "Get_saved_delta_token": {
              "runAfter": {
                "Initialize_changed_users": [
                  "Succeeded"
                ],
                "Initialize_has_more_pages": [
                  "Succeeded"
                ],
                "Initialize_current_url": [
                  "Succeeded"
                ],
                "Initialize_new_delta_link": [
                  "Succeeded"
                ],
                "Initialize_valid_roles_lower": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureblob']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/datasets/default/files/@{encodeURIComponent(encodeURIComponent('config/delta-token.txt'))}/content",
                "headers": {
                  "inferContentType": true
                }
              }
            },
            "Set_delta_url": {
              "runAfter": {
                "Get_saved_delta_token": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "currentUrl",
                "value": "@{if(equals(actions('Get_saved_delta_token')['status'], 'Succeeded'), trim(string(body('Get_saved_delta_token'))), 'https://graph.microsoft.com/v1.0/users/delta?$select=id,mail,department,displayName,userPrincipalName&$deltatoken=latest')}"
              }
            },
            "Follow_delta_pages": {
              "runAfter": {
                "Set_delta_url": [
                  "Succeeded"
                ]
              },
              "type": "Until",
              "expression": "@equals(variables('hasMorePages'), false)",
              "limit": {
                "count": 50,
                "timeout": "PT5M"
              },
              "actions": {
                "Call_graph_delta": {
                  "runAfter": {},
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "@variables('currentUrl')",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://graph.microsoft.com"
                    }
                  }
                },
                "Compute_merged_users": {
                  "runAfter": {
                    "Call_graph_delta": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@union(variables('changedUsers'), if(not(equals(body('Call_graph_delta')?['value'], null)), body('Call_graph_delta')?['value'], json('[]')))"
                },
                "Set_changed_users": {
                  "runAfter": {
                    "Compute_merged_users": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "changedUsers",
                    "value": "@outputs('Compute_merged_users')"
                  }
                },
                "Check_for_more_pages": {
                  "runAfter": {
                    "Set_changed_users": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "@body('Call_graph_delta')?['@odata.nextLink']",
                            null
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Set_next_page_url": {
                      "runAfter": {},
                      "type": "SetVariable",
                      "inputs": {
                        "name": "currentUrl",
                        "value": "@{body('Call_graph_delta')?['@odata.nextLink']}"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Store_delta_link": {
                        "runAfter": {},
                        "type": "SetVariable",
                        "inputs": {
                          "name": "newDeltaLink",
                          "value": "@{if(not(equals(body('Call_graph_delta')?['@odata.deltaLink'], null)), body('Call_graph_delta')?['@odata.deltaLink'], variables('currentUrl'))}"
                        }
                      },
                      "Mark_pagination_complete": {
                        "runAfter": {
                          "Store_delta_link": [
                            "Succeeded"
                          ]
                        },
                        "type": "SetVariable",
                        "inputs": {
                          "name": "hasMorePages",
                          "value": false
                        }
                      }
                    }
                  }
                }
              }
            },
            "Delete_old_delta_token": {
              "runAfter": {
                "Follow_delta_pages": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureblob']['connectionId']"
                  }
                },
                "method": "delete",
                "path": "/datasets/default/files/@{encodeURIComponent(encodeURIComponent('config/delta-token.txt'))}"
              }
            },
            "Save_delta_token": {
              "runAfter": {
                "Delete_old_delta_token": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureblob']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/default/files",
                "body": "@variables('newDeltaLink')",
                "queries": {
                  "folderPath": "/config",
                  "name": "delta-token.txt",
                  "queryParametersSingleEncoded": true
                },
                "headers": {
                  "Content-Type": "text/plain"
                }
              }
            },
            "Check_mapping_mode": {
              "runAfter": {
                "Save_delta_token": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('mappingMode')",
                      "mapped"
                    ]
                  }
                ]
              },
              "actions": {
                "Get_role_mapping_from_blob": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azureblob']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/datasets/default/files/@{encodeURIComponent(encodeURIComponent('config/role-mapping.json'))}/content"
                  }
                },
                "Parse_role_mapping": {
                  "runAfter": {
                    "Get_role_mapping_from_blob": [
                      "Succeeded"
                    ]
                  },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@body('Get_role_mapping_from_blob')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "departmentMapping": {
                          "type": "object"
                        },
                        "groupMapping": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Fetch_existing_PM_roles": {
              "runAfter": {
                "Check_mapping_mode": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('filterToExistingRoles')",
                      true
                    ]
                  },
                  {
                    "not": {
                      "equals": [
                        "@parameters('processManagerSiteUrl')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Get_PM_oauth_token": {
                  "runAfter": {},
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('processManagerSiteUrl')}/oauth2/token",
                    "headers": {
                      "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "body": "grant_type=password&username=@{encodeUriComponent(parameters('processManagerUsername'))}&password=@{encodeUriComponent(parameters('processManagerPassword'))}&duration=3600000"
                  }
                },
                "Get_PM_roles_html": {
                  "runAfter": {
                    "Get_PM_oauth_token": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('processManagerSiteUrl')}/Lookup/AssociateRoles.aspx",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_PM_oauth_token')?['access_token']}"
                    }
                  }
                },
                "Split_PM_roles_html": {
                  "runAfter": {
                    "Get_PM_roles_html": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@skip(split(string(body('Get_PM_roles_html')), 'checkbox-label\" for=\"R'), 1)"
                },
                "Extract_PM_role_names": {
                  "runAfter": {
                    "Split_PM_roles_html": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('Split_PM_roles_html')",
                    "select": "@toLower(trim(replace(replace(replace(replace(replace(first(split(substring(item(), add(indexOf(item(), '>'), 1)), '</label>')), '&amp;', '&'), '&#39;', ''''), '&quot;', '\"'), '&nbsp;', ' '), '&#246;', 'ö')))"
                  }
                },
                "Set_valid_roles_lower": {
                  "runAfter": {
                    "Extract_PM_role_names": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "validRolesLower",
                    "value": "@body('Extract_PM_role_names')"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "For_each_changed_user": {
              "runAfter": {
                "Fetch_existing_PM_roles": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@variables('changedUsers')",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              },
              "actions": {
                "Check_user_has_mail": {
                  "runAfter": {},
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "@coalesce(items('For_each_changed_user')?['mail'], items('For_each_changed_user')?['userPrincipalName'])",
                            null
                          ]
                        }
                      },
                      {
                        "not": {
                          "equals": [
                            "@coalesce(items('For_each_changed_user')?['mail'], items('For_each_changed_user')?['userPrincipalName'])",
                            ""
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Get_user_groups": {
                      "runAfter": {},
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "https://graph.microsoft.com/v1.0/users/@{items('For_each_changed_user')?['id']}/memberOf?$select=displayName",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://graph.microsoft.com"
                        }
                      }
                    },
                    "Check_role_mapping_mode": {
                      "runAfter": {
                        "Get_user_groups": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@parameters('mappingMode')",
                              "mapped"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Map_department_role": {
                          "runAfter": {},
                          "type": "Compose",
                          "inputs": "@if(or(empty(variables('validRolesLower')), contains(variables('validRolesLower'), toLower(trim(coalesce(coalesce(body('Parse_role_mapping')?['departmentMapping']?[items('For_each_changed_user')?['department']], body('Parse_role_mapping')?['departmentMapping']?['_default']), ''))))), coalesce(body('Parse_role_mapping')?['departmentMapping']?[items('For_each_changed_user')?['department']], body('Parse_role_mapping')?['departmentMapping']?['_default']), null)"
                        },
                        "Map_group_roles": {
                          "runAfter": {
                            "Map_department_role": [
                              "Succeeded"
                            ]
                          },
                          "type": "Select",
                          "inputs": {
                            "from": "@body('Get_user_groups')?['value']",
                            "select": "@if(or(empty(variables('validRolesLower')), contains(variables('validRolesLower'), toLower(trim(coalesce(coalesce(body('Parse_role_mapping')?['groupMapping']?[item()?['displayName']], body('Parse_role_mapping')?['groupMapping']?['_default']), ''))))), coalesce(body('Parse_role_mapping')?['groupMapping']?[item()?['displayName']], body('Parse_role_mapping')?['groupMapping']?['_default']), null)"
                          }
                        },
                        "Combine_mapped_roles": {
                          "runAfter": {
                            "Map_group_roles": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose",
                          "inputs": "@union(if(not(equals(outputs('Map_department_role'), null)), createArray(outputs('Map_department_role')), createArray()), body('Map_group_roles'))"
                        }
                      },
                      "else": {
                        "actions": {
                          "Get_department_role": {
                            "runAfter": {},
                            "type": "Compose",
                            "inputs": "@if(or(empty(variables('validRolesLower')), contains(variables('validRolesLower'), toLower(trim(coalesce(items('For_each_changed_user')?['department'], ''))))), items('For_each_changed_user')?['department'], null)"
                          },
                          "Filter_groups_to_valid_roles": {
                            "runAfter": {
                              "Get_department_role": [
                                "Succeeded"
                              ]
                            },
                            "type": "Query",
                            "inputs": {
                              "from": "@body('Get_user_groups')?['value']",
                              "where": "@or(empty(variables('validRolesLower')), contains(variables('validRolesLower'), toLower(trim(coalesce(item()?['displayName'], '')))))"
                            }
                          },
                          "Get_group_role_names": {
                            "runAfter": {
                              "Filter_groups_to_valid_roles": [
                                "Succeeded"
                              ]
                            },
                            "type": "Select",
                            "inputs": {
                              "from": "@body('Filter_groups_to_valid_roles')",
                              "select": "@item()?['displayName']"
                            }
                          },
                          "Combine_dynamic_roles": {
                            "runAfter": {
                              "Get_group_role_names": [
                                "Succeeded"
                              ]
                            },
                            "type": "Compose",
                            "inputs": "@union(if(not(equals(outputs('Get_department_role'), null)), createArray(outputs('Get_department_role')), createArray()), body('Get_group_role_names'))"
                          }
                        }
                      }
                    },
                    "Determine_all_roles": {
                      "runAfter": {
                        "Check_role_mapping_mode": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(equals(parameters('mappingMode'), 'mapped'), outputs('Combine_mapped_roles'), outputs('Combine_dynamic_roles'))"
                    },
                    "Filter_null_roles": {
                      "runAfter": {
                        "Determine_all_roles": [
                          "Succeeded"
                        ]
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('Determine_all_roles')",
                        "where": "@and(not(equals(item(), null)), not(equals(item(), '')))"
                      }
                    },
                    "Check_if_roles_found": {
                      "runAfter": {
                        "Filter_null_roles": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "greater": [
                              "@length(body('Filter_null_roles'))",
                              0
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Get_SCIM_user": {
                          "runAfter": {},
                          "type": "Http",
                          "inputs": {
                            "method": "GET",
                            "uri": "https://api.promapp.com/api/scim/users?filter=userName eq \"@{coalesce(items('For_each_changed_user')?['mail'], items('For_each_changed_user')?['userPrincipalName'])}\"",
                            "headers": {
                              "Authorization": "Bearer @{parameters('scimApiKey')}",
                              "Content-Type": "application/json"
                            }
                          }
                        },
                        "Parse_SCIM_response": {
                          "runAfter": {
                            "Get_SCIM_user": [
                              "Succeeded"
                            ]
                          },
                          "type": "ParseJson",
                          "inputs": {
                            "content": "@body('Get_SCIM_user')",
                            "schema": {
                              "type": "object",
                              "properties": {
                                "Resources": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string"
                                      },
                                      "userName": {
                                        "type": "string"
                                      },
                                      "name": {
                                        "type": "object",
                                        "properties": {
                                          "givenName": {
                                            "type": "string"
                                          },
                                          "familyName": {
                                            "type": "string"
                                          }
                                        }
                                      },
                                      "active": {
                                        "type": "boolean"
                                      },
                                      "emails": {
                                        "type": "array"
                                      },
                                      "roles": {
                                        "type": "array"
                                      }
                                    }
                                  }
                                },
                                "totalResults": {
                                  "type": "integer"
                                }
                              }
                            }
                          }
                        },
                        "Check_if_user_exists": {
                          "runAfter": {
                            "Parse_SCIM_response": [
                              "Succeeded"
                            ]
                          },
                          "type": "If",
                          "expression": {
                            "and": [
                              {
                                "greater": [
                                  "@body('Parse_SCIM_response')?['totalResults']",
                                  0
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Set_user_variable": {
                              "runAfter": {},
                              "type": "Compose",
                              "inputs": "@first(body('Parse_SCIM_response')?['Resources'])"
                            },
                            "Create_role_objects": {
                              "runAfter": {
                                "Set_user_variable": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Select",
                              "inputs": {
                                "from": "@body('Filter_null_roles')",
                                "select": {
                                  "display": "@item()"
                                }
                              }
                            },
                            "Prepare_final_roles": {
                              "runAfter": {
                                "Create_role_objects": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Compose",
                              "inputs": "@if(equals(parameters('updateMode'), 'replace'), body('Create_role_objects'), union(coalesce(outputs('Set_user_variable')?['roles'], createArray()), body('Create_role_objects')))"
                            },
                            "Update_SCIM_user": {
                              "runAfter": {
                                "Prepare_final_roles": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Http",
                              "inputs": {
                                "method": "PUT",
                                "uri": "https://api.promapp.com/api/scim/users/@{outputs('Set_user_variable')?['id']}",
                                "headers": {
                                  "Authorization": "Bearer @{parameters('scimApiKey')}",
                                  "Content-Type": "application/json"
                                },
                                "body": {
                                  "userName": "@{outputs('Set_user_variable')?['userName']}",
                                  "name": {
                                    "givenName": "@{outputs('Set_user_variable')?['name']?['givenName']}",
                                    "familyName": "@{outputs('Set_user_variable')?['name']?['familyName']}"
                                  },
                                  "active": "@coalesce(outputs('Set_user_variable')?['active'], true)",
                                  "emails": "@outputs('Set_user_variable')?['emails']",
                                  "roles": "@outputs('Prepare_final_roles')"
                                }
                              }
                            }
                          },
                          "else": {
                            "actions": {}
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azureblob": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureblobConnectionName'))]",
                "connectionName": "[variables('azureblobConnectionName')]",
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azureblob')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'full').identity.principalId]"
    }
  }
}
