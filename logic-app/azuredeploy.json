{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "ProcessManagerSCIMSync",
      "metadata": {
        "description": "Name of the Logic App"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "scimApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "Process Manager SCIM API Bearer Token"
      }
    },
    "roleMappingStorageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name where role-mapping.json is stored"
      }
    },
    "roleMappingContainerName": {
      "type": "string",
      "defaultValue": "config",
      "metadata": {
        "description": "Container name where role-mapping.json is stored"
      }
    },
    "updateMode": {
      "type": "string",
      "defaultValue": "preserve",
      "allowedValues": [
        "preserve",
        "replace"
      ],
      "metadata": {
        "description": "Role update mode: preserve (add roles) or replace (replace all roles)"
      }
    },
    "mappingMode": {
      "type": "string",
      "defaultValue": "dynamic",
      "allowedValues": [
        "dynamic",
        "mapped"
      ],
      "metadata": {
        "description": "Mapping mode: dynamic (use names as-is) or mapped (use role-mapping.json)"
      }
    }
  },
  "variables": {
    "office365ConnectionName": "[concat('office365-', uniqueString(resourceGroup().id))]",
    "azureblobConnectionName": "[concat('azureblob-', uniqueString(resourceGroup().id))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('office365ConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Office 365 Users Connection",
        "api": {
          "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365users')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('azureblobConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Azure Blob Storage Connection",
        "api": {
          "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azureblob')]"
        },
        "parameterValues": {
          "accountName": "[parameters('roleMappingStorageAccountName')]",
          "accessKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('roleMappingStorageAccountName')), '2021-09-01').keys[0].value]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('azureblobConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "scimApiKey": {
              "defaultValue": "[parameters('scimApiKey')]",
              "type": "SecureString"
            },
            "updateMode": {
              "defaultValue": "[parameters('updateMode')]",
              "type": "String"
            },
            "mappingMode": {
              "defaultValue": "[parameters('mappingMode')]",
              "type": "String"
            }
          },
          "triggers": {
            "When_a_user_is_updated": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365users']['connectionId']"
                  }
                },
                "body": {
                  "NotificationUrl": "@{listCallbackUrl()}"
                },
                "path": "/GraphSubscriptionPush",
                "queries": {
                  "subscriptionRequest/resource": "users",
                  "subscriptionRequest/changeType": "updated"
                }
              }
            }
          },
          "actions": {
            "Get_user_profile": {
              "runAfter": {},
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365users']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/users/@{encodeURIComponent(triggerBody()?['userId'])}"
              }
            },
            "Get_user_groups": {
              "runAfter": {
                "Get_user_profile": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365users']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/users/@{encodeURIComponent(body('Get_user_profile')?['Mail'])}/memberOf"
              }
            },
            "Check_mapping_mode": {
              "runAfter": {
                "Get_user_groups": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('mappingMode')",
                      "mapped"
                    ]
                  }
                ]
              },
              "actions": {
                "Get_role_mapping_from_blob": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azureblob']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/datasets/default/files/@{encodeURIComponent(encodeURIComponent('config/role-mapping.json'))}/content"
                  }
                },
                "Parse_role_mapping": {
                  "runAfter": {
                    "Get_role_mapping_from_blob": [
                      "Succeeded"
                    ]
                  },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@body('Get_role_mapping_from_blob')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "departmentMapping": {
                          "type": "object"
                        },
                        "groupMapping": {
                          "type": "object"
                        }
                      }
                    }
                  }
                },
                "Map_department_role": {
                  "runAfter": {
                    "Parse_role_mapping": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@coalesce(body('Parse_role_mapping')?['departmentMapping']?[body('Get_user_profile')?['Department']], body('Parse_role_mapping')?['departmentMapping']?['_default'])"
                },
                "Map_group_roles": {
                  "runAfter": {
                    "Map_department_role": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Get_user_groups')?['value']",
                    "select": "@coalesce(body('Parse_role_mapping')?['groupMapping']?[item()?['displayName']], body('Parse_role_mapping')?['groupMapping']?['_default'])"
                  }
                },
                "Combine_mapped_roles": {
                  "runAfter": {
                    "Map_group_roles": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@union(coalesce(outputs('Map_department_role'), createArray()), body('Map_group_roles'))"
                }
              },
              "else": {
                "actions": {
                  "Get_department_role": {
                    "runAfter": {},
                    "type": "Compose",
                    "inputs": "@body('Get_user_profile')?['Department']"
                  },
                  "Get_group_role_names": {
                    "runAfter": {
                      "Get_department_role": [
                        "Succeeded"
                      ]
                    },
                    "type": "Select",
                    "inputs": {
                      "from": "@body('Get_user_groups')?['value']",
                      "select": "@item()?['displayName']"
                    }
                  },
                  "Combine_dynamic_roles": {
                    "runAfter": {
                      "Get_group_role_names": [
                        "Succeeded"
                      ]
                    },
                    "type": "Compose",
                    "inputs": "@union(if(not(equals(outputs('Get_department_role'), null)), createArray(outputs('Get_department_role')), createArray()), body('Get_group_role_names'))"
                  }
                }
              }
            },
            "Determine_all_roles": {
              "runAfter": {
                "Check_mapping_mode": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(equals(parameters('mappingMode'), 'mapped'), body('Combine_mapped_roles'), body('Combine_dynamic_roles'))"
            },
            "Filter_null_roles": {
              "runAfter": {
                "Determine_all_roles": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@outputs('Determine_all_roles')",
                "where": "@and(not(equals(item(), null)), not(equals(item(), '')))"
              }
            },
            "Check_if_roles_found": {
              "runAfter": {
                "Filter_null_roles": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Filter_null_roles'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Get_SCIM_user": {
                  "runAfter": {},
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "https://api.promapp.com/api/scim/users?filter=userName eq \"@{body('Get_user_profile')?['Mail']}\"",
                    "headers": {
                      "Authorization": "Bearer @{parameters('scimApiKey')}",
                      "Content-Type": "application/json"
                    }
                  }
                },
                "Parse_SCIM_response": {
                  "runAfter": {
                    "Get_SCIM_user": [
                      "Succeeded"
                    ]
                  },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@body('Get_SCIM_user')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "Resources": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "userName": {
                                "type": "string"
                              },
                              "name": {
                                "type": "object",
                                "properties": {
                                  "givenName": {
                                    "type": "string"
                                  },
                                  "familyName": {
                                    "type": "string"
                                  }
                                }
                              },
                              "active": {
                                "type": "boolean"
                              },
                              "emails": {
                                "type": "array"
                              },
                              "roles": {
                                "type": "array"
                              }
                            }
                          }
                        },
                        "totalResults": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "Check_if_user_exists": {
                  "runAfter": {
                    "Parse_SCIM_response": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@body('Parse_SCIM_response')?['totalResults']",
                          0
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Set_user_variable": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": "@first(body('Parse_SCIM_response')?['Resources'])"
                    },
                    "Create_role_objects": {
                      "runAfter": {
                        "Set_user_variable": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@body('Filter_null_roles')",
                        "select": {
                          "display": "@item()"
                        }
                      }
                    },
                    "Prepare_final_roles": {
                      "runAfter": {
                        "Create_role_objects": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(equals(parameters('updateMode'), 'replace'), body('Create_role_objects'), union(coalesce(outputs('Set_user_variable')?['roles'], createArray()), body('Create_role_objects')))"
                    },
                    "Update_SCIM_user": {
                      "runAfter": {
                        "Prepare_final_roles": [
                          "Succeeded"
                        ]
                      },
                      "type": "Http",
                      "inputs": {
                        "method": "PUT",
                        "uri": "https://api.promapp.com/api/scim/users/@{outputs('Set_user_variable')?['id']}",
                        "headers": {
                          "Authorization": "Bearer @{parameters('scimApiKey')}",
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "userName": "@{outputs('Set_user_variable')?['userName']}",
                          "name": {
                            "givenName": "@{outputs('Set_user_variable')?['name']?['givenName']}",
                            "familyName": "@{outputs('Set_user_variable')?['name']?['familyName']}"
                          },
                          "active": "@coalesce(outputs('Set_user_variable')?['active'], true)",
                          "emails": "@outputs('Set_user_variable')?['emails']",
                          "roles": "@outputs('Prepare_final_roles')"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365users": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
                "connectionName": "[variables('office365ConnectionName')]",
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365users')]"
              },
              "azureblob": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureblobConnectionName'))]",
                "connectionName": "[variables('azureblobConnectionName')]",
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azureblob')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppUrl": {
      "type": "string",
      "value": "[listCallbackUrl(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/When_a_user_is_updated'), '2019-05-01').value]"
    }
  }
}
