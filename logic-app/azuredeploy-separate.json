{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "ProcessManagerSCIMSync",
      "metadata": {
        "description": "Name of the Logic App"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "scimApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "Process Manager SCIM API Bearer Token"
      }
    },
    "roleMappingStorageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name where role-mapping.json is stored"
      }
    },
    "roleMappingContainerName": {
      "type": "string",
      "defaultValue": "config",
      "metadata": {
        "description": "Container name where role-mapping.json is stored"
      }
    },
    "updateMode": {
      "type": "string",
      "defaultValue": "preserve",
      "allowedValues": [
        "preserve",
        "replace"
      ],
      "metadata": {
        "description": "Role update mode: preserve (add department role) or replace (replace all roles)"
      }
    },
    "mappingMode": {
      "type": "string",
      "defaultValue": "dynamic",
      "allowedValues": [
        "dynamic",
        "mapped"
      ],
      "metadata": {
        "description": "Mapping mode: dynamic (use department name as-is) or mapped (use role-mapping.json)"
      }
    },
    "filterToExistingRoles": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "If true, user groups/departments are filtered so only those that already exist as roles in Process Manager are synced. Prevents AD groups from creating new roles in PM. Requires processManagerSiteUrl, processManagerUsername, processManagerPassword."
      }
    },
    "processManagerSiteUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Process Manager tenant base URL, e.g. https://demo.promapp.com/{tenantId}. Used to fetch an OAuth token and the roles list. No trailing slash."
      }
    },
    "processManagerUsername": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Process Manager service-account username used for the OAuth password-grant token request."
      }
    },
    "processManagerPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Process Manager service-account password used for the OAuth password-grant token request."
      }
    }
  },
  "variables": {
    "office365ConnectionName": "[concat('office365-', uniqueString(resourceGroup().id))]",
    "azureblobConnectionName": "[concat('azureblob-', uniqueString(resourceGroup().id))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('office365ConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Office 365 Users Connection",
        "api": {
          "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365users')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('azureblobConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Azure Blob Storage Connection",
        "api": {
          "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azureblob')]"
        },
        "parameterValues": {
          "accountName": "[parameters('roleMappingStorageAccountName')]",
          "accessKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('roleMappingStorageAccountName')), '2021-09-01').keys[0].value]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('azureblobConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "scimApiKey": {
              "defaultValue": "[parameters('scimApiKey')]",
              "type": "SecureString"
            },
            "updateMode": {
              "defaultValue": "[parameters('updateMode')]",
              "type": "String"
            },
            "mappingMode": {
              "defaultValue": "[parameters('mappingMode')]",
              "type": "String"
            },
            "filterToExistingRoles": {
              "defaultValue": "[parameters('filterToExistingRoles')]",
              "type": "Bool"
            },
            "processManagerSiteUrl": {
              "defaultValue": "[parameters('processManagerSiteUrl')]",
              "type": "String"
            },
            "processManagerUsername": {
              "defaultValue": "[parameters('processManagerUsername')]",
              "type": "String"
            },
            "processManagerPassword": {
              "defaultValue": "[parameters('processManagerPassword')]",
              "type": "SecureString"
            }
          },
          "triggers": {
            "When_a_user_is_updated": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365users']['connectionId']"
                  }
                },
                "body": {
                  "NotificationUrl": "@{listCallbackUrl()}"
                },
                "path": "/GraphSubscriptionPush",
                "queries": {
                  "subscriptionRequest/resource": "users",
                  "subscriptionRequest/changeType": "updated"
                }
              }
            }
          },
          "actions": {
            "Initialize_valid_roles_lower": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "validRolesLower",
                    "type": "array",
                    "value": []
                  }
                ]
              }
            },
            "Get_user_profile": {
              "runAfter": {
                "Initialize_valid_roles_lower": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365users']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/users/@{encodeURIComponent(triggerBody()?['userId'])}"
              }
            },
            "Fetch_existing_PM_roles": {
              "runAfter": {
                "Get_user_profile": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('filterToExistingRoles')",
                      true
                    ]
                  },
                  {
                    "not": {
                      "equals": [
                        "@parameters('processManagerSiteUrl')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Get_PM_oauth_token": {
                  "runAfter": {},
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('processManagerSiteUrl')}/oauth2/token",
                    "headers": {
                      "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "body": "grant_type=password&username=@{encodeUriComponent(parameters('processManagerUsername'))}&password=@{encodeUriComponent(parameters('processManagerPassword'))}&duration=3600000"
                  }
                },
                "Get_PM_roles_html": {
                  "runAfter": {
                    "Get_PM_oauth_token": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('processManagerSiteUrl')}/Lookup/AssociateRoles.aspx",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_PM_oauth_token')?['access_token']}"
                    }
                  }
                },
                "Split_PM_roles_html": {
                  "runAfter": {
                    "Get_PM_roles_html": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@skip(split(string(body('Get_PM_roles_html')), 'checkbox-label\" for=\"R'), 1)"
                },
                "Extract_PM_role_names": {
                  "runAfter": {
                    "Split_PM_roles_html": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('Split_PM_roles_html')",
                    "select": "@toLower(trim(replace(replace(replace(replace(replace(first(split(substring(item(), add(indexOf(item(), '>'), 1)), '</label>')), '&amp;', '&'), '&#39;', ''''), '&quot;', '\"'), '&nbsp;', ' '), '&#246;', 'ö')))"
                  }
                },
                "Set_valid_roles_lower": {
                  "runAfter": {
                    "Extract_PM_role_names": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "validRolesLower",
                    "value": "@body('Extract_PM_role_names')"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Check_mapping_mode": {
              "runAfter": {
                "Fetch_existing_PM_roles": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('mappingMode')",
                      "mapped"
                    ]
                  }
                ]
              },
              "actions": {
                "Get_role_mapping_from_blob": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azureblob']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/datasets/default/files/@{encodeURIComponent(encodeURIComponent('config/role-mapping.json'))}/content"
                  }
                },
                "Parse_role_mapping": {
                  "runAfter": {
                    "Get_role_mapping_from_blob": [
                      "Succeeded"
                    ]
                  },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@body('Get_role_mapping_from_blob')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "departmentMapping": {
                          "type": "object"
                        },
                        "groupMapping": {
                          "type": "object"
                        }
                      }
                    }
                  }
                },
                "Set_mapped_role": {
                  "runAfter": {
                    "Parse_role_mapping": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@if(or(empty(variables('validRolesLower')), contains(variables('validRolesLower'), toLower(trim(coalesce(coalesce(body('Parse_role_mapping')?['departmentMapping']?[body('Get_user_profile')?['Department']], body('Parse_role_mapping')?['departmentMapping']?['_default']), ''))))), coalesce(body('Parse_role_mapping')?['departmentMapping']?[body('Get_user_profile')?['Department']], body('Parse_role_mapping')?['departmentMapping']?['_default']), null)"
                }
              },
              "else": {
                "actions": {
                  "Set_dynamic_role": {
                    "runAfter": {},
                    "type": "Compose",
                    "inputs": "@if(or(empty(variables('validRolesLower')), contains(variables('validRolesLower'), toLower(trim(coalesce(body('Get_user_profile')?['Department'], ''))))), body('Get_user_profile')?['Department'], null)"
                  }
                }
              }
            },
            "Determine_final_role": {
              "runAfter": {
                "Check_mapping_mode": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(equals(parameters('mappingMode'), 'mapped'), body('Set_mapped_role'), body('Set_dynamic_role'))"
            },
            "Check_if_role_found": {
              "runAfter": {
                "Determine_final_role": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@outputs('Determine_final_role')",
                        "@null"
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@outputs('Determine_final_role')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Get_SCIM_users": {
                  "runAfter": {},
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "https://api.promapp.com/api/scim/users?filter=userName eq \"@{body('Get_user_profile')?['Mail']}\"",
                    "headers": {
                      "Authorization": "Bearer @{parameters('scimApiKey')}",
                      "Content-Type": "application/json"
                    }
                  }
                },
                "Parse_SCIM_response": {
                  "runAfter": {
                    "Get_SCIM_users": [
                      "Succeeded"
                    ]
                  },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@body('Get_SCIM_users')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "Resources": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "userName": {
                                "type": "string"
                              },
                              "name": {
                                "type": "object",
                                "properties": {
                                  "givenName": {
                                    "type": "string"
                                  },
                                  "familyName": {
                                    "type": "string"
                                  }
                                }
                              },
                              "active": {
                                "type": "boolean"
                              },
                              "emails": {
                                "type": "array"
                              },
                              "roles": {
                                "type": "array"
                              }
                            }
                          }
                        },
                        "totalResults": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "Check_if_user_exists": {
                  "runAfter": {
                    "Parse_SCIM_response": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@body('Parse_SCIM_response')?['totalResults']",
                          0
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Set_user_variable": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": "@first(body('Parse_SCIM_response')?['Resources'])"
                    },
                    "Normalize_dept_roles_to_array": {
                      "runAfter": {
                        "Set_user_variable": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(equals(parameters('mappingMode'), 'mapped'), coalesce(outputs('Determine_final_role'), createArray()), if(not(equals(outputs('Determine_final_role'), null)), createArray(outputs('Determine_final_role')), createArray()))"
                    },
                    "Create_dept_role_objects": {
                      "runAfter": {
                        "Normalize_dept_roles_to_array": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@outputs('Normalize_dept_roles_to_array')",
                        "select": {
                          "display": "@item()"
                        }
                      }
                    },
                    "Prepare_roles_array": {
                      "runAfter": {
                        "Create_dept_role_objects": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@if(equals(parameters('updateMode'), 'replace'), body('Create_dept_role_objects'), union(coalesce(outputs('Set_user_variable')?['roles'], createArray()), body('Create_dept_role_objects')))"
                    },
                    "Update_SCIM_user": {
                      "runAfter": {
                        "Prepare_roles_array": [
                          "Succeeded"
                        ]
                      },
                      "type": "Http",
                      "inputs": {
                        "method": "PUT",
                        "uri": "https://api.promapp.com/api/scim/users/@{outputs('Set_user_variable')?['id']}",
                        "headers": {
                          "Authorization": "Bearer @{parameters('scimApiKey')}",
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "userName": "@{outputs('Set_user_variable')?['userName']}",
                          "name": {
                            "givenName": "@{outputs('Set_user_variable')?['name']?['givenName']}",
                            "familyName": "@{outputs('Set_user_variable')?['name']?['familyName']}"
                          },
                          "active": "@coalesce(outputs('Set_user_variable')?['active'], true)",
                          "emails": "@outputs('Set_user_variable')?['emails']",
                          "roles": "@outputs('Prepare_roles_array')"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365users": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
                "connectionName": "[variables('office365ConnectionName')]",
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365users')]"
              },
              "azureblob": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureblobConnectionName'))]",
                "connectionName": "[variables('azureblobConnectionName')]",
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azureblob')]"
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[concat(parameters('logicAppName'), '-GroupSync')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('azureblobConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "scimApiKey": {
              "defaultValue": "[parameters('scimApiKey')]",
              "type": "SecureString"
            },
            "updateMode": {
              "defaultValue": "[parameters('updateMode')]",
              "type": "String"
            },
            "mappingMode": {
              "defaultValue": "[parameters('mappingMode')]",
              "type": "String"
            },
            "filterToExistingRoles": {
              "defaultValue": "[parameters('filterToExistingRoles')]",
              "type": "Bool"
            },
            "processManagerSiteUrl": {
              "defaultValue": "[parameters('processManagerSiteUrl')]",
              "type": "String"
            },
            "processManagerUsername": {
              "defaultValue": "[parameters('processManagerUsername')]",
              "type": "String"
            },
            "processManagerPassword": {
              "defaultValue": "[parameters('processManagerPassword')]",
              "type": "SecureString"
            }
          },
          "triggers": {
            "When_group_membership_changes": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365users']['connectionId']"
                  }
                },
                "body": {
                  "NotificationUrl": "@{listCallbackUrl()}"
                },
                "path": "/GraphSubscriptionPush",
                "queries": {
                  "subscriptionRequest/resource": "groups",
                  "subscriptionRequest/changeType": "updated"
                }
              }
            }
          },
          "actions": {
            "Initialize_valid_roles_lower": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "validRolesLower",
                    "type": "array",
                    "value": []
                  }
                ]
              }
            },
            "Get_group_details": {
              "runAfter": {
                "Initialize_valid_roles_lower": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365users']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/groups/@{encodeURIComponent(triggerBody()?['resourceData']?['id'])}"
              }
            },
            "Get_group_members": {
              "runAfter": {
                "Get_group_details": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365users']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/groups/@{encodeURIComponent(triggerBody()?['resourceData']?['id'])}/members"
              }
            },
            "Fetch_existing_PM_roles": {
              "runAfter": {
                "Get_group_members": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('filterToExistingRoles')",
                      true
                    ]
                  },
                  {
                    "not": {
                      "equals": [
                        "@parameters('processManagerSiteUrl')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Get_PM_oauth_token": {
                  "runAfter": {},
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('processManagerSiteUrl')}/oauth2/token",
                    "headers": {
                      "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "body": "grant_type=password&username=@{encodeUriComponent(parameters('processManagerUsername'))}&password=@{encodeUriComponent(parameters('processManagerPassword'))}&duration=3600000"
                  }
                },
                "Get_PM_roles_html": {
                  "runAfter": {
                    "Get_PM_oauth_token": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('processManagerSiteUrl')}/Lookup/AssociateRoles.aspx",
                    "headers": {
                      "Authorization": "Bearer @{body('Get_PM_oauth_token')?['access_token']}"
                    }
                  }
                },
                "Split_PM_roles_html": {
                  "runAfter": {
                    "Get_PM_roles_html": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@skip(split(string(body('Get_PM_roles_html')), 'checkbox-label\" for=\"R'), 1)"
                },
                "Extract_PM_role_names": {
                  "runAfter": {
                    "Split_PM_roles_html": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('Split_PM_roles_html')",
                    "select": "@toLower(trim(replace(replace(replace(replace(replace(first(split(substring(item(), add(indexOf(item(), '>'), 1)), '</label>')), '&amp;', '&'), '&#39;', ''''), '&quot;', '\"'), '&nbsp;', ' '), '&#246;', 'ö')))"
                  }
                },
                "Set_valid_roles_lower": {
                  "runAfter": {
                    "Extract_PM_role_names": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "validRolesLower",
                    "value": "@body('Extract_PM_role_names')"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "For_each_member": {
              "foreach": "@body('Get_group_members')?['value']",
              "actions": {
                "Get_user_groups": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['office365users']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/users/@{encodeURIComponent(items('For_each_member')?['mail'])}/memberOf"
                  }
                },
                "Check_mapping_mode_for_groups": {
                  "runAfter": {
                    "Get_user_groups": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@parameters('mappingMode')",
                          "mapped"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Get_role_mapping_from_blob_groups": {
                      "runAfter": {},
                      "type": "ApiConnection",
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['azureblob']['connectionId']"
                          }
                        },
                        "method": "get",
                        "path": "/datasets/default/files/@{encodeURIComponent(encodeURIComponent('config/role-mapping.json'))}/content"
                      }
                    },
                    "Parse_role_mapping_groups": {
                      "runAfter": {
                        "Get_role_mapping_from_blob_groups": [
                          "Succeeded"
                        ]
                      },
                      "type": "ParseJson",
                      "inputs": {
                        "content": "@body('Get_role_mapping_from_blob_groups')",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "departmentMapping": {
                              "type": "object"
                            },
                            "groupMapping": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    },
                    "Map_groups_to_roles": {
                      "runAfter": {
                        "Parse_role_mapping_groups": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@body('Get_user_groups')?['value']",
                        "select": "@if(or(empty(variables('validRolesLower')), contains(variables('validRolesLower'), toLower(trim(coalesce(coalesce(body('Parse_role_mapping_groups')?['groupMapping']?[item()?['displayName']], body('Parse_role_mapping_groups')?['groupMapping']?['_default']), ''))))), coalesce(body('Parse_role_mapping_groups')?['groupMapping']?[item()?['displayName']], body('Parse_role_mapping_groups')?['groupMapping']?['_default']), null)"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Filter_groups_to_valid_roles": {
                        "runAfter": {},
                        "type": "Query",
                        "inputs": {
                          "from": "@body('Get_user_groups')?['value']",
                          "where": "@or(empty(variables('validRolesLower')), contains(variables('validRolesLower'), toLower(trim(coalesce(item()?['displayName'], '')))))"
                        }
                      },
                      "Map_groups_directly": {
                        "runAfter": {
                          "Filter_groups_to_valid_roles": [
                            "Succeeded"
                          ]
                        },
                        "type": "Select",
                        "inputs": {
                          "from": "@body('Filter_groups_to_valid_roles')",
                          "select": "@item()?['displayName']"
                        }
                      }
                    }
                  }
                },
                "Determine_roles_from_groups": {
                  "runAfter": {
                    "Check_mapping_mode_for_groups": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@if(equals(parameters('mappingMode'), 'mapped'), body('Map_groups_to_roles'), body('Map_groups_directly'))"
                },
                "Filter_null_roles": {
                  "runAfter": {
                    "Determine_roles_from_groups": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@outputs('Determine_roles_from_groups')",
                    "where": "@not(equals(item(), null))"
                  }
                },
                "Check_if_roles_found": {
                  "runAfter": {
                    "Filter_null_roles": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@length(body('Filter_null_roles'))",
                          0
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Get_SCIM_users_by_email": {
                      "runAfter": {},
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "https://api.promapp.com/api/scim/users?filter=userName eq \"@{items('For_each_member')?['mail']}\"",
                        "headers": {
                          "Authorization": "Bearer @{parameters('scimApiKey')}",
                          "Content-Type": "application/json"
                        }
                      }
                    },
                    "Parse_SCIM_response_groups": {
                      "runAfter": {
                        "Get_SCIM_users_by_email": [
                          "Succeeded"
                        ]
                      },
                      "type": "ParseJson",
                      "inputs": {
                        "content": "@body('Get_SCIM_users_by_email')",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "Resources": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  },
                                  "userName": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "object",
                                    "properties": {
                                      "givenName": {
                                        "type": "string"
                                      },
                                      "familyName": {
                                        "type": "string"
                                      }
                                    }
                                  },
                                  "active": {
                                    "type": "boolean"
                                  },
                                  "emails": {
                                    "type": "array"
                                  },
                                  "roles": {
                                    "type": "array"
                                  }
                                }
                              }
                            },
                            "totalResults": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    },
                    "Check_if_user_exists_in_scim": {
                      "runAfter": {
                        "Parse_SCIM_response_groups": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "greater": [
                              "@body('Parse_SCIM_response_groups')?['totalResults']",
                              0
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Set_user_variable_groups": {
                          "runAfter": {},
                          "type": "Compose",
                          "inputs": "@first(body('Parse_SCIM_response_groups')?['Resources'])"
                        },
                        "Prepare_role_objects": {
                          "runAfter": {
                            "Set_user_variable_groups": [
                              "Succeeded"
                            ]
                          },
                          "type": "Select",
                          "inputs": {
                            "from": "@body('Filter_null_roles')",
                            "select": {
                              "display": "@item()"
                            }
                          }
                        },
                        "Prepare_final_roles_array": {
                          "runAfter": {
                            "Prepare_role_objects": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose",
                          "inputs": "@if(equals(parameters('updateMode'), 'replace'), body('Prepare_role_objects'), union(coalesce(outputs('Set_user_variable_groups')?['roles'], createArray()), body('Prepare_role_objects')))"
                        },
                        "Update_SCIM_user_with_groups": {
                          "runAfter": {
                            "Prepare_final_roles_array": [
                              "Succeeded"
                            ]
                          },
                          "type": "Http",
                          "inputs": {
                            "method": "PUT",
                            "uri": "https://api.promapp.com/api/scim/users/@{outputs('Set_user_variable_groups')?['id']}",
                            "headers": {
                              "Authorization": "Bearer @{parameters('scimApiKey')}",
                              "Content-Type": "application/json"
                            },
                            "body": {
                              "userName": "@{outputs('Set_user_variable_groups')?['userName']}",
                              "name": {
                                "givenName": "@{outputs('Set_user_variable_groups')?['name']?['givenName']}",
                                "familyName": "@{outputs('Set_user_variable_groups')?['name']?['familyName']}"
                              },
                              "active": "@coalesce(outputs('Set_user_variable_groups')?['active'], true)",
                              "emails": "@outputs('Set_user_variable_groups')?['emails']",
                              "roles": "@outputs('Prepare_final_roles_array')"
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              },
              "runAfter": {
                "Fetch_existing_PM_roles": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365users": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
                "connectionName": "[variables('office365ConnectionName')]",
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365users')]"
              },
              "azureblob": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('azureblobConnectionName'))]",
                "connectionName": "[variables('azureblobConnectionName')]",
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azureblob')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppUrl": {
      "type": "string",
      "value": "[listCallbackUrl(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/When_a_user_is_updated'), '2019-05-01').value]"
    },
    "groupSyncLogicAppUrl": {
      "type": "string",
      "value": "[listCallbackUrl(concat(resourceId('Microsoft.Logic/workflows', concat(parameters('logicAppName'), '-GroupSync')), '/triggers/When_group_membership_changes'), '2019-05-01').value]"
    }
  }
}
